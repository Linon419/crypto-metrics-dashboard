{
    "name": "crypto-dashboard-server",
    "version": "1.0.0",
    "description": "Backend for cryptocurrency metrics dashboard",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon index.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "//": "版本必须与仓库根 package.json 保持一致：Docker 只装 server/ 的依赖，而一键启动器打包时不带 server/node_modules、只能解析到根依赖。两边版本一旦分叉，同一份代码在容器里和本地跑的就是不同的库（此前 express 4 与 5 的分叉曾导致启动器直接崩溃）。",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "axios": "^1.9.0",
        "bcryptjs": "^3.0.2",
        "body-parser": "^2.2.0",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "openai": "^4.98.0",
        "sequelize": "^6.37.7",
        "sqlite3": "^5.1.7",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "nodemon": "^2.0.22",
        "sequelize-cli": "^6.6.0"
    }
}
