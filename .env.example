# Shared configuration for local development, one-click launchers, and Docker.
# Copy this file to `.env`, then fill in the values you need.
# Production Docker deployments must replace JWT_SECRET and ADMIN_PASSWORD.

# Server
PORT=3001
# Leave empty to use the launcher/Compose default. Set your HTTPS domain in production.
API_PUBLIC_HOST=
DB_STORAGE=./database.sqlite
JWT_SECRET=local-one-click-dashboard-secret-change-me-2026

# The local launcher downloads the sanitized starter database when DB_STORAGE is missing.
# LOCAL_DATABASE_URL=https://github.com/Linon419/crypto-metrics-dashboard/releases/latest/download/crypto-metrics-demo.sqlite.gz
# LOCAL_DATABASE_SHA256_URL=https://github.com/Linon419/crypto-metrics-dashboard/releases/latest/download/crypto-metrics-demo.sqlite.gz.sha256
# LOCAL_DATABASE_DOWNLOAD_DISABLED=0

# First local admin account. Used only when the database has no admin user.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Initial login password. The dashboard prompts you to replace it after login.
ADMIN_PASSWORD=123456
REGISTRATION_ENABLED=false

# Optional public demo accounts. Use ordinary user accounts, separated by commas.
DEMO_USERNAMES=
DEMO_READONLY=true

# AI parsing. Leave OPENAI_API_KEY empty if you only need to view existing data.
OPENAI_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Optional dedicated key for encrypting API credentials saved from Admin.
# Falls back to JWT_SECRET when empty. Keep the value stable after saving credentials.
AI_SETTINGS_ENCRYPTION_KEY=

# Optional logo provider client ID.
BRANDFETCH_CLIENT_ID=

# Telegram Bot, optional.
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:3001/api
ADMIN_CHAT_IDS=
TZ=Asia/Shanghai
