# Docker Compose 环境变量示例
#
# 以下留空项必须在部署前填写，否则服务会拒绝启动。
# 生成随机值：openssl rand -hex 32

# 生产环境必须：强随机密钥（长度>=32）。留空或使用占位值会导致启动失败
JWT_SECRET=

# First administrator.
# 生产部署必须显式设置一个至少 15 个字符的独立口令，不存在默认初始密码。
# 未修改初始密码前，除修改密码接口外的所有 API 都会返回 403。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
REGISTRATION_ENABLED=false

# 可选：对外试用账号（逗号分隔的用户名，不要写密码）。
# 登记后该账号豁免强制改密，但默认降为只读；管理员角色不会被接受。
# DEMO_READONLY=false 可放开写权限，公开部署不建议。
DEMO_USERNAMES=
DEMO_READONLY=true

# AI provider fallback configuration
OPENAI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# 可选。留空则回退到 JWT_SECRET。一旦保存过 API Key 就不要再更换此值
AI_SETTINGS_ENCRYPTION_KEY=

# 数据库（SQLite 文件路径）
DB_STORAGE=/data/db/database.sqlite

# 前端运行时 API 地址（用于 /app-config.js）
API_PUBLIC_HOST=http://localhost:3080

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_IDS=123456789,987654321
API_BASE_URL=http://localhost:3001/api

# 时区
TZ=Asia/Shanghai
